# Every variable is checked at startup (src/config/env/env-schema.ts): production does not start
# with an error, development prints which features are off and why. Check without starting:
# npm run check:env (add -- --production to check this file as production).
#
# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/xmenu
REDIS_URL=redis://localhost:6379
# Alternative to REDIS_URL (used only if REDIS_URL is unset):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Customer auth (phone + SMS OTP) — see customer-auth.config.ts
# The OTP_* settings, OTP_DEV_MODE and SMS_PROVIDER also drive owner (staff)
# signup codes (separate keys and counters, same rules).
# ---------------------------------------------------------------------------
# Required in every environment; in production each must also be at least
# 32 characters, and none of the three may equal each other or
# JWT_ACCESS_TOKEN_SECRET below — the app
# refuses to boot otherwise (see customer-auth.config.ts's secret() guard).
JWT_CUSTOMER_ACCESS_SECRET=change-me-to-a-random-32-plus-char-value
JWT_CUSTOMER_REGISTRATION_SECRET=change-me-to-a-different-random-value
OTP_HMAC_SECRET=change-me-to-another-random-value

# All optional; defaults match the spec (otp length 6, 5-minute TTL, 5
# attempts, 60s resend cooldown, 15-minute access token, 30-day refresh,
# 180-day absolute session ceiling, 10s refresh-reuse leeway).
# OTP_LENGTH=6
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_COOLDOWN_SECONDS=60
# Limits of code requests, owners and customers alike: per phone and purpose per hour and per day, per client IP
# per hour; and owner sign-ups per client IP per hour. The defaults are the production values. An e2e stack drives
# every browser from one loopback IP and raises them (see xmenu-e2e); never raise them in production.
# OTP_PHONE_HOURLY_LIMIT=5
# OTP_PHONE_DAILY_LIMIT=10
# OTP_IP_HOURLY_LIMIT=30
# STAFF_REGISTER_IP_HOURLY_LIMIT=10
# ACCESS_TTL_SECONDS=900
# REFRESH_TTL_DAYS=30
# SESSION_ABSOLUTE_DAYS=180
# REFRESH_REUSE_LEEWAY_SECONDS=10

# true skips sending anything and accepts a fixed code (digits 1234567890 cut
# to OTP_LENGTH). Keep it false wherever people should receive a real,
# random code via SMS_PROVIDER below (that includes the Telegram testing
# phase). Only for a local run without any provider. The app refuses to
# boot with this set to true when NODE_ENV=production.
OTP_DEV_MODE=false

# Which SmsProvider customer and owner OTPs go through: eskiz | telegram |
# console. Defaults to "eskiz" in production, "console" everywhere else;
# "console" is refused at boot when NODE_ENV=production.
#
# CURRENT PHASE — testing: codes go to a Telegram group instead of real SMS,
# so the team can test the phone+OTP flow without an Eskiz account. Set
# OTP_DEV_MODE=false above and fill in OTP_BOT / XMENU_CHAT_ID below.
SMS_PROVIDER=telegram
#
# LAUNCH — switch to real SMS: comment the line above back out (or set it
# to "eskiz"), fill in ESKIZ_EMAIL / ESKIZ_PASSWORD / ESKIZ_FROM below.
# No code changes needed either way — this one value is the whole switch.
# SMS_PROVIDER=eskiz

# Required only when SMS_PROVIDER=eskiz (or NODE_ENV=production without
# SMS_PROVIDER set, since eskiz is the production default). Production does not
# start without the credentials of the chosen provider.
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_FROM=4546

# Required while SMS_PROVIDER=telegram — same bot/group already used for
# sendApplicationToTelegram (src/infra/helper/tg-bot).
# Codes land in the group prefixed "🧪 Test SMS →", so they're easy to tell
# apart from real staff notifications in the same chat. This is a visible
# shared group, not a private channel — anyone reading it can read anyone's
# OTP, same as a tester's own phone would show it.
OTP_BOT=
XMENU_CHAT_ID=

# Optional: validating Telegram Mini App initData to link a customer's
# Telegram identity (see telegram-init-data.service.ts). A venue that has
# connected its own bot (PUT /telegram-bot) is checked with that bot's token;
# this platform token is the fallback for venues without one. Leave unset to
# disable it for them — phone+OTP keeps working either way.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400

# Phone verification through the venue's own bot (docs/TELEGRAM_VERIFICATION.md).
# Session lifetime in seconds. Venue bots also need an https PUBLIC_API_URL
# (webhooks) and PAYMENT_CONFIG_KEY (bot tokens are stored encrypted).
# TELEGRAM_VERIFY_TTL_SECONDS=300

# Base of every Bot API call (venue bots, order notifications, the OTP group
# above). Tests and e2e point it at a fake Telegram (docs/TELEGRAM_VERIFICATION.md,
# "Fake Telegram"). The API does not start with any other value than the default
# when NODE_ENV=production.
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# ---------------------------------------------------------------------------
# Public URLs
# ---------------------------------------------------------------------------
# Base URL of this API as the outside world sees it. Click and Payme webhook
# URLs shown to owners (GET /payment-provider) and venue bot webhooks
# (PUT /telegram-bot refuses to connect a bot otherwise) are built from it;
# required and https when NODE_ENV=production (venue bots need https in every environment).
PUBLIC_API_URL=http://localhost:3000
# Delivery site address of a venue; {slug} is replaced with the venue slug. The venue bot menu button and the
# /start greeting button open it as a Mini App (https only). Unset: the button is not set.
# Required (https, with {slug}) when NODE_ENV=production.
# DELIVERY_URL_TEMPLATE=https://{slug}.xmenu.uz
# Platform domain of the delivery sites: GET /tenant/by-host resolves {slug}.PLATFORM_DOMAIN by slug, and owners
# cannot add it or any host under it as their own domain. xmenu.uz in production (required there: the API does not
# start without it), localhost in development (cafe.localhost:3002).
PLATFORM_DOMAIN=localhost
# Development only: venue domains (e.g. a tunnel host for Mini App tests) are verified when added, without the DNS
# TXT check. The API does not start with true when NODE_ENV=production.
DOMAIN_VERIFY_SKIP=false
# DNS servers for the TXT check of venue domains, comma-separated ip[:port] (127.0.0.1:5353, [::1]:53). Empty: the
# system resolvers. The e2e stack points it at its fake DNS (docs/API.md, "Домены заведения"); in production it is
# allowed with a startup warning. An unreadable value stops the start.
DOMAIN_VERIFY_DNS_SERVERS=
# Base for absolute file URLs in responses (logo, banner, dish images).
# Falls back to PUBLIC_API_URL; without either, URLs stay relative. https when NODE_ENV=production.
PUBLIC_FILES_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Orders: platform Telegram bot, ops alerts, queues
# ---------------------------------------------------------------------------
# Bot that posts new orders to branch chats (falls back to TELEGRAM_BOT_TOKEN).
# TELEGRAM_ORDERS_BOT_TOKEN=
# secret_token set with setWebhook; webhook calls without it are refused.
TELEGRAM_WEBHOOK_SECRET=
# Chat for operational alerts (refunds, escalations); falls back to XMENU_CHAT_ID.
# OPS_CHAT_ID=
# "off" disables the BullMQ escalation and refund workers (local run without Redis); "on" is the default.
# ORDER_QUEUES=off

# ---------------------------------------------------------------------------
# Payments (Click, Payme on each venue's own merchant account)
# ---------------------------------------------------------------------------
# 32-byte key (64 hex chars or base64) encrypting the venues' payment keys
# and Telegram bot tokens (AES-256-GCM). Required once any venue saves payment
# keys or connects a bot; required when NODE_ENV=production. Losing it means every venue has to enter its keys
# and bot token again. Generate: openssl rand -hex 32
PAYMENT_CONFIG_KEY=
# Where the payment page returns the customer: a template with {orderId},
# or MINIAPP_URL + /order/{orderId}. Unset: no return URL.
# MINIAPP_RETURN_URL=https://order.example/order/{orderId}
# MINIAPP_URL=

# ---------------------------------------------------------------------------
# Front-end cache revalidation (revalidate-queue, docs/REVALIDATE.md)
# ---------------------------------------------------------------------------
# QR menu front-end base URL; menu and slug changes POST to {NEXT_PUBLIC_URL}/api/revalidate.
NEXT_PUBLIC_URL=http://localhost:3001
# Shared with the QR menu front-end. NEXT_PUBLIC_URL set + empty secret: warning in development,
# the API does not start with NODE_ENV=production.
REVALIDATE_SECRET=
# Delivery site (xmenu-client): full URL of its revalidation endpoint, e.g.
# http://127.0.0.1:3002/api/revalidate. Empty = no jobs for the delivery site.
CLIENT_REVALIDATE_URL=
# Shared with xmenu-client. CLIENT_REVALIDATE_URL set + empty secret: warning in development,
# the API does not start with NODE_ENV=production.
CLIENT_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Staff / organization auth (restaurant owners, admins) — separate realm,
# different secrets, different /auth/* routes. See config/index.ts.
# ---------------------------------------------------------------------------
# Required in production (falls back to an insecure built-in default
# otherwise, which is fine for local dev but refused at boot when
# NODE_ENV=production).
JWT_ACCESS_TOKEN_SECRET=change-me-to-a-random-value
JWT_ACCESS_TOKEN_EXPIRATION_TIME=1h
# Owner refresh tokens are opaque, stored hashed in staff_session and rotated on every refresh.
# STAFF_REFRESH_TTL_DAYS=7
# STAFF_SESSION_ABSOLUTE_DAYS=30
# STAFF_REFRESH_REUSE_LEEWAY_SECONDS=30

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# HTTP_TIMEOUT=5000
# HTTP_MAX_REDIRECTS=5

# Upload size limit in bytes (default 5 MB)
# UPLOAD_MAX_BYTES=5242880

# Per client IP rate limits of public POST requests (429 rate_limited + Retry-After). Webhooks of Click,
# Payme and Telegram are exempt. The general limit is generous: mobile operators share one IP.
# PUBLIC_POST_RATE_LIMIT=120
# PUBLIC_POST_RATE_WINDOW_SECONDS=60
# POST /application (landing form), stricter
# APPLICATION_RATE_LIMIT=5
# APPLICATION_RATE_WINDOW_SECONDS=3600

# Comma-separated user ids allowed to read platform data (GET /application). Empty = nobody.
PLATFORM_ADMIN_USER_IDS=

# /translation (OpenAI). Optional: without a key the API starts and /translation answers 503 translation_unavailable.
OPENAI_API_KEY=
# /translation limits per owner and per client IP (all owners behind it)
# TRANSLATION_RATE_LIMIT=30
# TRANSLATION_RATE_WINDOW_SECONDS=600
# TRANSLATION_IP_RATE_LIMIT=60
# TRANSLATION_IP_RATE_WINDOW_SECONDS=600
# TRANSLATION_MAX_TEXT=2000

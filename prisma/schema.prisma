// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum ApplicationFrom {
  admin
  web
}

model application {
  id         String           @id @default(uuid())
  fullName   String?
  phone      String?
  from       ApplicationFrom
  plan       String?
  description String?          // qo‘shimcha maydon (agar kerak bo‘lsa)
  created_at DateTime          @default(now())
}
// Restoran filiallari. Mijoz ilovasida pickup tanlash, buyurtma qabul qilish
// va buyurtma xabarnomalari (Telegram guruhi) shu yerdan.
//
// Ish vaqti jadvali (branch_working_hours) va istisnolar (branch_hours_exception)
// dan serverda hours / isOpen / opensAt hisoblanadi — kontrakt: docs/BRANCHES_API.md.
model branch {
  id              String   @id @default(uuid())

  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  title           String
  address         String
  latitude        Float
  longitude       Float
  phone           String?

  is_active       Boolean  @default(true)
  sort_order      Int      @default(0)
  timezone        String   @default("Asia/Tashkent")
  accepts_pickup   Boolean @default(true)
  accepts_delivery Boolean @default(true)

  // Buyurtma xabarnomalari yuboriladigan Telegram guruh/chat (bot a'zo bo'lishi shart)
  telegram_chat_id String?

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  working_hours   branch_working_hours[]
  hours_exceptions branch_hours_exception[]
  orders          customer_order[]

  @@index([organization_id, is_active, sort_order])
}

// Haftaning har kuni uchun bitta oraliq. weekday: ISO, 1 = dushanba ... 7 = yakshanba.
// closes_at <= opens_at bo'lsa — ertasi kuni yopiladi (tungi smena).
model branch_working_hours {
  id         String  @id @default(uuid())
  branch_id  String
  branch     branch  @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  weekday    Int
  opens_at   String  @default("00:00") // HH:mm
  closes_at  String  @default("00:00") // HH:mm
  is_24h     Boolean @default(false)
  is_closed  Boolean @default(false)

  @@unique([branch_id, weekday])
}

// Muayyan sana uchun istisno (bayram, ta'mir). is_closed yoki boshqa vaqt.
model branch_hours_exception {
  id         String   @id @default(uuid())
  branch_id  String
  branch     branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  date       DateTime @db.Date
  opens_at   String?
  closes_at  String?
  is_24h     Boolean  @default(false)
  is_closed  Boolean  @default(false)
  note       String?

  @@unique([branch_id, date])
}

model category_translation {
  id         String    @id @default(uuid())
  lang       String   
  title    String
  category    category  @relation(fields: [category_id], references: [id], onDelete: Cascade)
  category_id  String
  created_at  DateTime  @default(now())
}
model category {
  id         String    @id @default(uuid())
  created_at  DateTime  @default(now())
  is_active  Boolean? @default(true) 
  index            Int?

  translations    category_translation[]

  organization    organization   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  organization_id  String

  products product[]
}// Mijozning saqlangan yetkazib berish manzillari. Tenant alohida ustun emas:
// customer_id orqali customer.organization_id ga bog'langan, shuning uchun
// har bir so'rov customer orqali tenantni ham tekshiradi.
//
// Migration 20261007100000_customer_address_integrity qo'lda qo'shgan, Prisma
// ifodalay olmaydigan qoidalar: har bir mijozga BITTA is_default=true
// (partial unique index) va latitude/longitude juftligi CHECK constraint.
model customer_address {
  id          String   @id @default(uuid())

  customer_id String
  customer    customer @relation(fields: [customer_id],references: [id],onDelete: Cascade)

  title       String?  // Home, Work
  address     String
  latitude    Float?
  longitude   Float?

  apartment   String?
  entrance    String?
  floor       String?
  comment     String?

  is_default  Boolean  @default(false)

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([customer_id])
}
// Audit jurnali. Ataylab FK yo'q: mijoz/tenant o'chsa ham yozuvlar qoladi.
model customer_auth_event {
  id              BigInt   @id @default(autoincrement())
  organization_id String?
  customer_id     String?
  type            String
  phone_masked    String?
  ip              String?
  user_agent      String?
  meta            Json?
  created_at      DateTime @default(now())

  @@index([created_at])
}

// Refresh-token sessiyalari. Faqat SHA-256 hash saqlanadi.
// family_id — bitta login = bitta oila; har refresh yangi "avlod" qatori yaratadi.
model customer_session {
  id                String    @id @default(uuid())
  family_id         String
  family_started_at DateTime  // oilaning birinchi yaratilgan vaqti (absolyut limit uchun)

  customer_id       String
  customer          customer  @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  organization_id   String
  token_hash        Bytes     @unique
  parent_id         String?

  created_at        DateTime  @default(now())
  expires_at        DateTime
  used_at           DateTime?
  revoked_at        DateTime?

  user_agent        String?
  ip                String?

  @@index([family_id])
  @@index([customer_id])
}

enum CustomerStatus {
  active
  blocked
}

// Mijoz bitta tenantga (organization) tegishli.
// Bir xil telefon ikki tenantda = ikki xil customer.
// (organization_id, phone) bo'yicha PARTIAL unique index (deleted_at IS NULL)
// migration 20261006120000_customer_phone_partial_unique ichida qo'lda
// yaratilgan — Prisma buni schema orqali ifodalay olmaydi (filtered index
// emas). Shu YAGONA constraint CustomerAuthService.register() dagi P2002
// race-recovery filialini ishga tushiradi — uni olib tashlamang.
model customer {
  id              String         @id @default(uuid())

  organization_id String
  organization    organization   @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  phone           String         // E.164: +998XXXXXXXXX
  telegram_id     String?
  name            String
  status          CustomerStatus @default(active)

  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  last_login_at   DateTime?
  deleted_at      DateTime?

  addresses       customer_address[]
  sessions        customer_session[]
  orders          customer_order[]

  @@unique([organization_id, telegram_id])
  @@index([organization_id, phone])
}

model employee {
  id    String    @id @default(uuid())
  first_name String
  last_name String?
  phone String @unique
  password String
  url String
  status String
  organization    organization   @relation(fields: [organization_id], references: [id])
  organization_id  String
  created_at  DateTime  @default(now())
}model file {
  id                     String           @id @default(uuid())
  url                    String
  path                   String
  created_at             DateTime         @default(now())

  user                   user?

  organization_logo      organization?    @relation("OrganizationLogo")

  organization_banner    organization?    @relation("OrganizationBanner")

  product             product?      @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id          String?
}
// Mijoz buyurtmasi. Barcha narxlar butun so'mda (UZS). Pozitsiyalar, manzil va
// filial nomlari buyurtma vaqtidagi SNAPSHOT: menyu yoki manzil keyin
// o'zgarsa ham buyurtma o'zgarmaydi.
//
// Dublikat himoyasi: (customer_id, idempotency_key) unique — bir xil kalit
// bilan takror so'rov yangi buyurtma yaratmaydi.
// Optimistik blok: `version` har status o'zgarishida oshadi (OrderTransitionService).
model customer_order {
  id              String   @id @default(uuid())
  // Tenant ichidagi ko'rinadigan raqam (organization.order_seq dan)
  number          Int

  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  customer_id     String
  customer        customer     @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  branch_id       String
  branch          branch       @relation(fields: [branch_id], references: [id], onDelete: Restrict)

  status          OrderStatus
  fulfillment     OrderFulfillment
  version         Int      @default(0)

  idempotency_key String
  request_hash    String

  phone           String
  comment         String?
  // Yetkazib berish manzili snapshot'i (pickup uchun null)
  address_snapshot Json?

  payment_method     OrderPaymentMethod
  payment_status     OrderPaymentStatus
  payment_expires_at DateTime?

  currency        String
  subtotal        Int
  service_fee     Int      @default(0)
  discount        Int      @default(0)
  total           Int

  eta_min         Int
  eta_max         Int

  cancelled_by    OrderActor?
  cancel_reason   String?
  cancelled_at    DateTime?

  // Restoran buyurtmani qabul qilish uchun olgan payt (to'langan yoki naqd)
  placed_at       DateTime?
  accepted_at     DateTime?
  completed_at    DateTime?

  // Restoran guruhiga yuborilgan xabar (keyin tahrirlash uchun)
  tg_chat_id      String?
  tg_message_id   Int?

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  items           customer_order_item[]
  payments        order_payment[]
  events          order_status_event[]

  @@unique([organization_id, number])
  @@unique([customer_id, idempotency_key])
  @@index([organization_id, status, created_at])
  @@index([customer_id, created_at])
  @@index([branch_id, status])
}

model customer_order_item {
  id          String  @id @default(uuid())
  order_id    String
  order       customer_order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  // Mahsulot keyin o'chirilsa ham pozitsiya qoladi
  product_id  String?
  product     product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  name        String
  image       String?
  weight      String?
  base_price  Int
  unit_price  Int
  quantity    Int
  position    Int

  options     customer_order_item_option[]

  @@index([order_id])
}

model customer_order_item_option {
  id          String  @id @default(uuid())
  item_id     String
  item        customer_order_item @relation(fields: [item_id], references: [id], onDelete: Cascade)

  group_id    String?
  group_title String
  option_id   String?
  name        String
  price       Int
  position    Int

  @@index([item_id])
}

// Status o'zgarishlari audit jurnali (faqat qo'shiladi).
model order_status_event {
  id          BigInt      @id @default(autoincrement())
  order_id    String
  order       customer_order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  from_status OrderStatus?
  to_status   OrderStatus
  actor       OrderActor
  actor_id    String?
  note        String?
  created_at  DateTime    @default(now())

  @@index([order_id, created_at])
}
// Buyurtma hayot sikli — frontend (features/orders/lib/orderModel.js) bilan bir xil.
enum OrderStatus {
  awaiting_payment
  payment_failed
  pending_acceptance
  accepted
  preparing
  on_the_way
  ready
  completed
  cancelled
}

enum OrderFulfillment {
  delivery
  pickup
}

enum OrderPaymentMethod {
  cash
  click
  payme
}

enum OrderPaymentStatus {
  not_required
  pending
  paid
  failed
  cancelled
  refund_pending
  refunded
}

// Kim amalga oshirdi (status tarixi) / kim bekor qildi.
enum OrderActor {
  customer
  restaurant
  system
  payment
}
// Ordering settings of a tenant (one row per organization). The row is created at signup with the
// platform defaults (organization/domain/platform-defaults.ts) and must exist: the code never
// substitutes values for a missing row (order-settings.service.ts).
model organization_order_settings {
  organization_id String   @id
  organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  delivery_service_fee Int
  min_order_delivery   Int
  min_order_pickup     Int
  eta_min              Int
  eta_max              Int

  // Restoran buyurtmani qabul qilmasa — shu vaqtdan keyin avtomatik bekor (soniya)
  acceptance_timeout_seconds Int
  // Onlayn to'lov oynasi (soniya)
  payment_timeout_seconds    Int
  // Bir vaqtda faol buyurtmalar soni chegarasi (suiiste'moldan himoya)
  max_active_orders          Int

  // Delivery zone: [[lat, lng], ...], at least 3 points. null = delivery is unavailable.
  delivery_zone Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// Public settings of a tenant (one row per organization, created at signup with the platform
// defaults from organization/domain/platform-defaults.ts). Read by GET /tenant/config, edited
// through PUT /organization/:id/settings. NULL = the owner has not filled it in.
model organization_settings {
  organization_id String       @id
  organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // Brand colors: { brand: "#EE2E17", ... }, keys from THEME_KEYS (domain/organization-settings.ts)
  theme            Json?
  currency         String
  default_language String
  languages        String[]

  support_phone    String?
  support_telegram String?
  support_hours    String?
  address          String?
  founded_year     Int?

  city           String?
  map_center_lat Float?
  map_center_lng Float?
  map_zoom       Int?
  // [[swLat, swLng], [neLat, neLng]]
  map_bounds     Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model organization_translation {
  id         String    @id @default(uuid())
  lang       String   
  description    String
  organization    organization   @relation(fields: [organization_id], references: [id])
  organization_id  String
  created_at  DateTime  @default(now())
}
enum OrganizationType {
  restaurant   @map("restaurant")
  cafe         @map("cafe")
  fast_food    @map("fast_food")
  coffee_shop  @map("coffee_shop")
  other        @map("other")
}

// Ordering front-ends: the website ({slug}.xmenu.uz), the venue's Telegram Mini App, or both
enum DeliveryMode {
  site     @map("site")
  miniapp  @map("miniapp")
  both     @map("both")
}

model organization {
  id           String            @id @default(uuid())
  int_id       Int               @unique @default(autoincrement())
  name         String
  slug         String?           @unique
  type         OrganizationType  @default(other)
  is_active     Boolean           @default(false)
  // Channels (PUT /organization/:id/channels); new venues get PLATFORM_CHANNELS (platform-defaults.ts).
  qr_enabled       Boolean       @default(true)
  // The ordering channel: website and/or Mini App orders, delivery and pickup alike
  delivery_enabled Boolean       @default(false)
  delivery_mode    DeliveryMode  @default(site)
  // Set by POST /organization/:id/publish once the checklist passes; NULL = never published or paused.
  // Orders need delivery_enabled AND published_at (domain/publication.ts orderingProblem).
  published_at     DateTime?
  url          String?
  created_at   DateTime          @default(now())
  translations organization_translation[]
  categories   category[]
  employees    employee[]
  customers    customer[]
  branches     branch[]
  orders       customer_order[]
  settings          organization_settings?
  order_settings    organization_order_settings?
  payment_providers organization_payment_provider[]
  telegram_bot      organization_telegram_bot?
  additional_product_groups additional_product_group[]
  // Tenant ichidagi buyurtma raqami hisoblagichi (atomik UPDATE ... RETURNING)
  order_seq    Int               @default(1000)

  owner_id     String?           @unique
  owner        user?             @relation(fields: [owner_id], references: [id])

  logo_id      String?           @unique
  logo         file?             @relation("OrganizationLogo", fields: [logo_id], references: [id])

  banner_id    String?           @unique
  banner       file?             @relation("OrganizationBanner", fields: [banner_id], references: [id])
}enum OrderPaymentProvider {
  click
  payme
}

enum PaymentTransactionStatus {
  created
  paid
  cancelled
  refunded
  failed
}

// Provayder tranzaksiyasi (Click prepare/complete, Payme Create/Perform).
// Bir buyurtmada bir nechta bo'lishi mumkin (qayta to'lash urinishlari).
model order_payment {
  id          String  @id @default(uuid())
  // Click merchant_prepare_id — butun son sifatida beriladi
  seq         Int     @unique @default(autoincrement())

  order_id    String
  order       customer_order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  provider    OrderPaymentProvider
  status      PaymentTransactionStatus @default(created)
  amount      Int

  // Payme: tranzaksiya id; Click: click_trans_id
  provider_transaction_id String?
  // Click: click_paydoc_id — qaytarish (reversal) API'si shu id bilan ishlaydi
  provider_payment_id     String?
  // Payme holati: 1 yaratilgan, 2 bajarilgan, -1 bekor (bajarilmasdan), -2 bekor (bajarilgandan keyin)
  provider_state          Int?
  // Payme time (ms)
  provider_create_time    BigInt?
  // Provayder qaytargan sabab kodi (Payme reason)
  cancel_reason           Int?

  expires_at   DateTime?
  performed_at DateTime?
  cancelled_at DateTime?
  refunded_at  DateTime?

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([provider, provider_transaction_id])
  @@index([order_id])
}

// Tenantning Click/Payme kalitlari. config_encrypted — AES-256-GCM (base64),
// kalit PAYMENT_CONFIG_KEY env'da (payment-config.crypto.ts).
model organization_payment_provider {
  id              String   @id @default(uuid())
  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  provider        OrderPaymentProvider
  is_enabled      Boolean  @default(true)
  config_encrypted String

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([organization_id, provider])
}


model additional_product_group_translation {
  id         String    @id @default(uuid())
  lang       String   
  title    String
  additional_product_group    additional_product_group  @relation(fields: [additional_product_group_id], references: [id], onDelete: Cascade)
  additional_product_group_id  String
  created_at  DateTime  @default(now())
}


model additional_product_group {
  id         String    @id @default(uuid())
  created_at  DateTime  @default(now())
  is_required  Boolean? @default(false) 
  is_multiple Boolean? @default(false)
  // Tanlov chegaralari (null = is_required/is_multiple bo'yicha standart)
  min_selected Int?
  max_selected Int?

  translations    additional_product_group_translation[]

  additional_products additional_product[]

  product    product?   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id  String?

  // Owner. Set on create, so a group made before its dish (product_id still empty) is not ownerless.
  organization    organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  organization_id String?

  @@index([organization_id])
}

model additional_product_translation {
  id         String    @id @default(uuid())
  lang       String   
  title    String
  additional_product    additional_product  @relation(fields: [additional_product_id], references: [id], onDelete: Cascade)
  additional_product_id  String
  created_at  DateTime  @default(now())
}

model additional_product {
  id         String    @id @default(uuid())
  created_at  DateTime  @default(now())
  price Float

  translations    additional_product_translation[]

  additional_product_group    additional_product_group   @relation(fields: [additional_product_group_id], references: [id], onDelete: Cascade)
  additional_product_group_id  String
}

model product_translation {
  id         String    @id @default(uuid())
  lang       String   
  title    String
  description    String?
  product    product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id  String
  created_at  DateTime  @default(now())
}
enum product_unit {
  gr
  ml
}


model product {
  id         String    @id @default(uuid())
  created_at  DateTime  @default(now())
  is_active  Boolean? @default(true) 
  index            Int?
  price  Float
  weight  Float?
  protein Float?
  kcal Float?
  fat Float?
  carbohydrate Float?
  unit product_unit

  translations    product_translation[]

  additional_product_groups additional_product_group[]

  category    category   @relation(fields: [category_id], references: [id], onDelete: Cascade)
  category_id  String

  images       file[]

  order_items  customer_order_item[]
}

// The venue's own Telegram bot: created in @BotFather, token entered in the dashboard.
// token_encrypted: AES-256-GCM, same format and key (PAYMENT_CONFIG_KEY) as payment provider keys.
// One bot belongs to one venue only (telegram_bot_id is unique).
model organization_telegram_bot {
  id              String       @id @default(uuid())
  organization_id String       @unique
  organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  telegram_bot_id String       @unique
  username        String
  token_encrypted String
  // secret_token given to setWebhook: webhook calls must carry it in a header
  webhook_secret  String
  is_enabled      Boolean      @default(true)

  // Bot profile the owner edited: { ru|uz|en: { name, description, shortDescription, menuButtonText } }.
  // NULL = never edited, values come from the venue's own data (domain/bot-profile.ts).
  profile         Json?
  // Outcome of the last push of the profile to Telegram, per item (domain/bot-profile.ts SyncResult)
  synced_at       DateTime?
  sync_result     Json?

  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
}
model translation_prompt {
  id        Int      @id @default(autoincrement())
  title     String
  context   String   
  created_at DateTime @default(now())
}// Audit log for owner (staff) auth. No FKs on purpose: records outlive deleted users and organizations.
// Owner refresh-token sessions. Only the SHA-256 hash of the token is stored.
// family_id: one login = one family; every refresh adds a row (rotation), reuse revokes the family.
model staff_session {
  id                String    @id @default(uuid())
  family_id         String
  family_started_at DateTime

  user_id           String
  user              user      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  token_hash        Bytes     @unique
  parent_id         String?

  created_at        DateTime  @default(now())
  expires_at        DateTime
  used_at           DateTime?
  revoked_at        DateTime?

  user_agent        String?
  ip                String?

  @@index([family_id])
  @@index([user_id])
}

model staff_auth_event {
  id              BigInt   @id @default(autoincrement())
  user_id         String?
  organization_id String?
  type            String
  phone_masked    String?
  ip              String?
  user_agent      String?
  meta            Json?
  created_at      DateTime @default(now())

  @@index([created_at])
  @@index([user_id])
}
model user {
  id          String      @id @default(uuid())
  phone       String      @unique
  password    String?
  email       String?
  first_name  String?
  last_name   String?
  url         String?
  isActive  Boolean @default(false) 
  created_at  DateTime    @default(now())
  organization organization?
  sessions     staff_session[]
  avatar_id    String?      @unique
  avatar       file?        @relation(fields: [avatar_id], references: [id])
}
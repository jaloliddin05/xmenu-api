model file {
  id                     String           @id @default(uuid())
  url                    String
  path                   String
  created_at             DateTime         @default(now())
  // sha256 (hex) of the content; set for pictures copied from the POS, which share one file on disk
  content_hash           String?
  // Copied from the POS (an owner upload is false and wins over the POS picture)
  from_pos               Boolean          @default(false)

  user                   user?

  organization_logo      organization?    @relation("OrganizationLogo")

  organization_banner    organization?    @relation("OrganizationBanner")

  product             product?      @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id          String?
}



model additional_product_group_translation {
  id         String    @id @default(uuid())
  lang       String   
  title    String
  additional_product_group    additional_product_group  @relation(fields: [additional_product_group_id], references: [id], onDelete: Cascade)
  additional_product_group_id  String
  created_at  DateTime  @default(now())
}
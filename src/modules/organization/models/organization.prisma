
enum OrganizationType {
  restaurant   @map("restaurant")
  cafe         @map("cafe")
  fast_food    @map("fast_food")
  coffee_shop  @map("coffee_shop")
  other        @map("other")
}

model organization {
  id           String            @id @default(uuid())
  int_id       Int               @unique @default(autoincrement())
  name         String
  slug         String?           @unique
  type         OrganizationType  @default(other)
  is_active     Boolean           @default(false)
  url          String?
  created_at   DateTime          @default(now())
  translations organization_translation[]
  categories   category[]
  employees    employee[]
  customers    customer[]
  branches     branch[]
  orders       customer_order[]
  settings          organization_settings?
  order_settings    organization_order_settings?
  payment_providers organization_payment_provider[]
  telegram_bot      organization_telegram_bot?
  additional_product_groups additional_product_group[]
  // Tenant ichidagi buyurtma raqami hisoblagichi (atomik UPDATE ... RETURNING)
  order_seq    Int               @default(1000)

  owner_id     String?           @unique
  owner        user?             @relation(fields: [owner_id], references: [id])

  logo_id      String?           @unique
  logo         file?             @relation("OrganizationLogo", fields: [logo_id], references: [id])

  banner_id    String?           @unique
  banner       file?             @relation("OrganizationBanner", fields: [banner_id], references: [id])
}
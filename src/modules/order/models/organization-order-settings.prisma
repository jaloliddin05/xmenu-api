// Ordering settings of a tenant (one row per organization). The row is created at signup with the
// platform defaults (organization/domain/platform-defaults.ts) and must exist: the code never
// substitutes values for a missing row (order-settings.service.ts).
model organization_order_settings {
  organization_id String   @id
  organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  min_order_pickup     Int
  // Delivery fees are rounded up to this step: 100, 500 or 1000
  delivery_price_step  Int
  // Who delivers: own couriers, external services or both; external only offers no cash on delivery
  courier_mode         CourierMode
  // Payment methods offered at delivery (docs/DELIVERY.md): cash, a card to the courier, online. Cash and card
  // need own couriers; online needs a connected provider (order/domain/delivery-payment.ts)
  delivery_pay_cash    Boolean
  delivery_pay_card    Boolean
  delivery_pay_online  Boolean

  // Restoran buyurtmani qabul qilmasa — shu vaqtdan keyin avtomatik bekor (soniya)
  acceptance_timeout_seconds Int
  // Onlayn to'lov oynasi (soniya)
  payment_timeout_seconds    Int
  // Bir vaqtda faol buyurtmalar soni chegarasi (suiiste'moldan himoya)
  max_active_orders          Int

  // Delivery timers (docs/DELIVERY.md): remind the courier and the operator when "picked up" is not pressed
  // this long after "ready"; alert the operator when an order is on the way longer; wait at the door after
  // "no answer", then the operator decides
  pickup_reminder_minutes    Int
  on_the_way_alert_minutes   Int
  door_wait_minutes          Int
  // Courier pay per delivery plus per started kilometre (straight line) over the included distance.
  // All three null: no pay is accrued. A courier may have an own rate (courier.pay_*).
  courier_pay_per_delivery   Int?
  courier_pay_included_km    Float?
  courier_pay_per_km         Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// Ordering settings of a tenant (one row per organization). The row is created at signup with the
// platform defaults (organization/domain/platform-defaults.ts) and must exist: the code never
// substitutes values for a missing row (order-settings.service.ts).
model organization_order_settings {
  organization_id String   @id
  organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  min_order_pickup     Int
  // Delivery fees are rounded up to this step: 100, 500 or 1000
  delivery_price_step  Int
  // Who delivers: own couriers, external services or both; external only offers no cash on delivery
  courier_mode         CourierMode

  // Restoran buyurtmani qabul qilmasa — shu vaqtdan keyin avtomatik bekor (soniya)
  acceptance_timeout_seconds Int
  // Onlayn to'lov oynasi (soniya)
  payment_timeout_seconds    Int
  // Bir vaqtda faol buyurtmalar soni chegarasi (suiiste'moldan himoya)
  max_active_orders          Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// Buyurtma hayot sikli — frontend (features/orders/lib/orderModel.js) bilan bir xil.
enum OrderStatus {
  awaiting_payment
  payment_failed
  pending_acceptance
  accepted
  preparing
  on_the_way
  ready
  // Delivery: the courier is at the door and cannot hand over (no answer, refused); the operator decides
  problem_at_door
  completed
  cancelled
  // Delivery closed without a delivery: the order went back to the restaurant
  returned_to_restaurant
  // Delivery closed by handing the order to an external service (no integration)
  handed_to_external
}

enum OrderFulfillment {
  delivery
  pickup
}

enum OrderPaymentMethod {
  cash
  click
  payme
}

enum OrderPaymentStatus {
  not_required
  pending
  paid
  failed
  cancelled
  refund_pending
  refunded
}

// Kim amalga oshirdi (status tarixi) / kim bekor qildi.
enum OrderActor {
  customer
  restaurant
  courier
  system
  payment
}

// Where the guest placed the order: the venue site, or its Telegram Mini App (initData checked by the venue bot).
enum OrderChannel {
  site
  miniapp
}

// Who delivers the venue's orders (organization_order_settings.courier_mode).
enum CourierMode {
  own
  external
  both
}

// How the guest paid a cash order at the door: banknotes (handed in at the shift end) or a card to the courier
enum CashCollection {
  cash
  card
}

// Why a courier could not hand over at the door (problem_at_door)
enum DoorProblem {
  no_answer
  refused
}

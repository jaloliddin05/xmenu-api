// Mijoz buyurtmasi. Barcha narxlar butun so'mda (UZS). Pozitsiyalar, manzil va
// filial nomlari buyurtma vaqtidagi SNAPSHOT: menyu yoki manzil keyin
// o'zgarsa ham buyurtma o'zgarmaydi.
//
// Dublikat himoyasi: (customer_id, idempotency_key) unique — bir xil kalit
// bilan takror so'rov yangi buyurtma yaratmaydi.
// Optimistik blok: `version` har status o'zgarishida oshadi (OrderTransitionService).
model customer_order {
  id              String   @id @default(uuid())
  // Tenant ichidagi ko'rinadigan raqam (organization.order_seq dan)
  number          Int

  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  customer_id     String
  customer        customer     @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  branch_id       String
  branch          branch       @relation(fields: [branch_id], references: [id], onDelete: Restrict)

  status          OrderStatus
  fulfillment     OrderFulfillment
  version         Int      @default(0)

  idempotency_key String
  request_hash    String

  phone           String
  comment         String?
  // Yetkazib berish manzili snapshot'i (pickup uchun null)
  address_snapshot Json?

  payment_method     OrderPaymentMethod
  payment_status     OrderPaymentStatus
  payment_expires_at DateTime?

  currency        String
  subtotal        Int
  // Delivery fee fixed when the order was placed (0 for pickup and free delivery)
  delivery_fee    Int      @default(0)
  discount        Int      @default(0)
  total           Int

  // Cash orders: the banknote the guest pays with, so the courier brings change
  cash_change_from Int?
  // Own courier of the venue (docs/DELIVERY.md): set on "accepted", locked after "picked up"
  courier_id          String?
  courier             courier?       @relation(fields: [courier_id], references: [id], onDelete: SetNull)
  courier_assigned_at DateTime?
  // The courier's shift the order was assigned in (cash to hand in is counted per shift)
  courier_shift_id    String?
  courier_shift       courier_shift? @relation(fields: [courier_shift_id], references: [id], onDelete: SetNull)
  door_problem        DoorProblem?
  door_problem_reason String?
  // Delivery timers start at these moments (docs/DELIVERY.md, "Напоминания")
  ready_at            DateTime?
  picked_up_at        DateTime?
  door_problem_at     DateTime?
  // Cash orders delivered by a courier: banknotes or a card to the courier
  cash_collected      CashCollection?
  // Courier pay accrued at delivery: straight-line km from the branch and the amount (null: no rate set)
  courier_distance_km Float?
  courier_pay         Int?
  // Handed to an external service (handed_to_external): its name, what the venue paid it, when; for a cash
  // order the operator marks later whether the venue got the money (null: not marked yet)
  external_service       String?
  external_cost          Int?
  external_handed_at     DateTime?
  external_cash_received Boolean?

  cancelled_by    OrderActor?
  cancel_reason   String?
  cancelled_at    DateTime?

  // Restoran buyurtmani qabul qilish uchun olgan payt (to'langan yoki naqd)
  placed_at       DateTime?
  accepted_at     DateTime?
  completed_at    DateTime?

  channel         OrderChannel @default(site)
  // Mini App orders only: the guest's Telegram id and the venue bot (Telegram bot id) that opened the
  // Mini App. Status and refund notifications go there and nowhere else (notifications/guest-notification.ts)
  guest_telegram_id     String?
  guest_telegram_bot_id String?

  // Restoran guruhiga yuborilgan xabar (keyin tahrirlash uchun)
  tg_chat_id      String?
  tg_message_id   Int?

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  items           customer_order_item[]
  payments        order_payment[]
  events          order_status_event[]
  courier_cards   courier_card[]
  pos_order       pos_order?

  @@unique([organization_id, number])
  @@unique([customer_id, idempotency_key])
  @@index([organization_id, status, created_at])
  @@index([customer_id, created_at])
  @@index([branch_id, status])
  @@index([courier_id, status])
  @@index([courier_shift_id, status])
  @@index([organization_id, external_handed_at])
}

model customer_order_item {
  id          String  @id @default(uuid())
  order_id    String
  order       customer_order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  // Mahsulot keyin o'chirilsa ham pozitsiya qoladi
  product_id  String?
  product     product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  name        String
  image       String?
  weight      String?
  base_price  Int
  unit_price  Int
  quantity    Int
  position    Int

  options     customer_order_item_option[]

  @@index([order_id])
}

model customer_order_item_option {
  id          String  @id @default(uuid())
  item_id     String
  item        customer_order_item @relation(fields: [item_id], references: [id], onDelete: Cascade)

  group_id    String?
  group_title String
  option_id   String?
  name        String
  price       Int
  position    Int

  @@index([item_id])
}

// Status o'zgarishlari audit jurnali (faqat qo'shiladi).
model order_status_event {
  id          BigInt      @id @default(autoincrement())
  order_id    String
  order       customer_order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  from_status OrderStatus?
  to_status   OrderStatus
  actor       OrderActor
  actor_id    String?
  note        String?
  created_at  DateTime    @default(now())

  @@index([order_id, created_at])
}

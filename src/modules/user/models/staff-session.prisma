// Owner refresh-token sessions. Only the SHA-256 hash of the token is stored.
// family_id: one login = one family; every refresh adds a row (rotation), reuse revokes the family.
model staff_session {
  id                String    @id @default(uuid())
  family_id         String
  family_started_at DateTime

  user_id           String
  user              user      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  token_hash        Bytes     @unique
  parent_id         String?

  created_at        DateTime  @default(now())
  expires_at        DateTime
  used_at           DateTime?
  revoked_at        DateTime?

  user_agent        String?
  ip                String?

  @@index([family_id])
  @@index([user_id])
}

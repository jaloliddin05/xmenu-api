// Audit log for owner (staff) auth. No FKs on purpose: records outlive deleted users and organizations.
model staff_auth_event {
  id              BigInt   @id @default(autoincrement())
  user_id         String?
  organization_id String?
  type            String
  phone_masked    String?
  ip              String?
  user_agent      String?
  meta            Json?
  created_at      DateTime @default(now())

  @@index([created_at])
  @@index([user_id])
}

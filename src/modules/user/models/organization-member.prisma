// Staff of a venue: the owner and the operators. Access rules per role: auth/access/permissions.ts.
enum StaffRole {
  owner     @map("owner")
  operator  @map("operator")
}

enum StaffStatus {
  // Invited by the owner, the phone is not confirmed yet (user_id is NULL)
  invited   @map("invited")
  active    @map("active")
  // Disabled by the owner: the user cannot sign in, an open invitation is cancelled
  disabled  @map("disabled")
}

model organization_member {
  id                String        @id @default(uuid())
  organization_id   String
  organization      organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  // NULL until the invitation is accepted. Unique: one venue per staff user for now.
  user_id           String?       @unique
  user              user?         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role              StaffRole
  status            StaffStatus
  phone             String
  first_name        String
  last_name         String?
  invited_by_id     String?
  invite_expires_at DateTime?
  created_at        DateTime      @default(now())
  activated_at      DateTime?
  disabled_at       DateTime?

  @@unique([organization_id, phone])
  @@index([phone])
}

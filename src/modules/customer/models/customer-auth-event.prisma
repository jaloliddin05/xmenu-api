
// Audit jurnali. Ataylab FK yo'q: mijoz/tenant o'chsa ham yozuvlar qoladi.
model customer_auth_event {
  id              BigInt   @id @default(autoincrement())
  organization_id String?
  customer_id     String?
  type            String
  phone_masked    String?
  ip              String?
  user_agent      String?
  meta            Json?
  created_at      DateTime @default(now())

  @@index([created_at])
}

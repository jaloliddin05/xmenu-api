
// Own courier of a venue (docs/DELIVERY.md, "Курьеры, смены и наличные"). Couriers are shared by all
// branches of the venue and work only in the chat with the venue bot; they have no dashboard access.
model courier {
  id              String   @id @default(uuid())
  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  name            String
  phone           String
  // false: the courier lost access at once (bot buttons refused, unfinished orders taken away)
  is_active       Boolean  @default(true)
  // Set when the courier opens the invitation in Telegram; the venue bot talks to this user only
  telegram_user_id String?
  telegram_chat_id String?
  // Telegram language_code of the courier, for the bot texts (ru, uz, en)
  language_code   String?
  linked_at       DateTime?
  // Own pay rate of the courier (all three set) instead of the venue's; null: the venue's rate
  pay_per_delivery Int?
  pay_included_km  Float?
  pay_per_km       Int?
  disabled_at     DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  invitations     courier_invitation[]
  shifts          courier_shift[]
  orders          customer_order[]
  cards           courier_card[]

  @@unique([organization_id, phone])
  @@unique([organization_id, telegram_user_id])
  @@index([organization_id, is_active])
}

// One-time link to the venue bot: t.me/<bot>?start=c_<token>. Only the sha256 of the token is stored.
model courier_invitation {
  id          String   @id @default(uuid())
  courier_id  String
  courier     courier  @relation(fields: [courier_id], references: [id], onDelete: Cascade)
  token_hash  String   @unique
  expires_at  DateTime
  used_at     DateTime?
  // A newer invitation (or disabling the courier) voids the unused ones
  revoked_at  DateTime?
  created_at  DateTime @default(now())

  @@index([courier_id])
}

enum CourierShiftStatus {
  open
  // Ended: waits for the cash reconciliation (done by the operator)
  awaiting_reconciliation
  reconciled
}

// A courier's shift. At most one open shift per courier (partial unique index in the migration).
model courier_shift {
  id              String   @id @default(uuid())
  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  courier_id      String
  courier         courier  @relation(fields: [courier_id], references: [id], onDelete: Cascade)
  status          CourierShiftStatus @default(open)
  started_at      DateTime @default(now())
  ended_at        DateTime?
  // courier (the bot button) or staff (closed in the dashboard)
  ended_by        String?
  ended_by_user_id String?
  // Cash reconciliation, once, by the operator: due = cash of the orders the courier delivered in the
  // shift (fixed at reconciliation), received = what the operator got, discrepancy = received - due
  cash_due         Int?
  cash_received    Int?
  cash_discrepancy Int?
  reconciled_at    DateTime?
  reconciled_by_user_id String?
  orders          customer_order[]

  @@index([organization_id, status])
  @@index([courier_id, status])
}

// The order card in a courier's chat: one message per (order, courier), edited on every change.
// A courier who was taken off the order keeps the row so the old card can be shortened.
model courier_card {
  id          String   @id @default(uuid())
  order_id    String
  order       customer_order @relation(fields: [order_id], references: [id], onDelete: Cascade)
  courier_id  String
  courier     courier  @relation(fields: [courier_id], references: [id], onDelete: Cascade)
  chat_id     String
  message_id  Int
  updated_at  DateTime @updatedAt

  @@unique([order_id, courier_id])
}
